# Build-time configuration.
#
# Everything in this file is PUBLIC: it is baked into the Docker image at
# build time and served verbatim to the browser at /config (except BACKEND /
# BACKEND_HOST, which only end up in nginx.conf). Never put secrets here.
#
# Copy to `.env` and adjust before building:
#   cp .env.example .env
#   docker build -t ai-chatbot .
#   docker run -p 3000:3000 ai-chatbot

# Imbrace platform endpoints (client-side, served at /config)
IMBRACE_BASE_URL=http://localhost:9000
IMBRACE_APP_GATEWAY_URL=http://localhost:9001
IMBRACE_NEXT_BEST_ACTION_URL=http://localhost:3000
IMBRACE_WORKFLOW_DOMAIN=localhost:8080

# nginx upstream that the container proxies /appgateway/* and /ai-agent/* to.
# When unset, BACKEND defaults to IMBRACE_APP_GATEWAY_URL and BACKEND_HOST to
# its hostname.
#BACKEND=http://localhost:9001
#BACKEND_HOST=localhost
